{
    "target": {
        "name": "codal-microbit-v2",
        "type": "git",

	// "url": "https://github.com/lancaster-university/codal-microbit-v2",
        // "branch": "34bf4b004a1b6c54abd60201a35b1985c25d4730",

	"url": "https://github.com/attila-lendvai-patches/codal-microbit-v2",
        "branch": "master",

        "branches": {
            // "https://github.com/lancaster-university/codal-core": "3d485abf65d7e692aa51e9611d37689ebaa59e00",
            "https://github.com/attila-lendvai-patches/codal-core.git": "master",

	    // "https://github.com/lancaster-university/codal-nrf52": "140d1be19b0f9a9e3c8901928b57d64fc0f7a8a3",
            "https://github.com/attila-lendvai-patches/codal-nrf52.git": "master",

            "https://github.com/microbit-foundation/codal-microbit-nrf5sdk": "4b8abc690f6c9fca6132e6db5ee13a795a263f88"
        }
    },
    "config":{
	"DMESG_SERIAL_DEBUG": 0,
	"MICROBIT_DMESG_LEVEL": 0,
	"CODAL_DEBUG": 0,
	// Emit LUA_MEM Lua-heap reports at boot markers; needs DMESG_SERIAL_DEBUG=1
	// to be visible, and CODAL_DEBUG=2 to also dump the CODAL heap.
	// ! Must do a clean build after changing it: ./build.py --clean
	"LUA_MEM_DEBUG": 0,
	// Store Lua numbers as 32-bit float instead of double: smaller TValue and
	// hardware single-precision arithmetic. Integers above 2^24 become
	// approximate.
	// ! Must do a clean build after changing it: ./build.py --clean
	"LUA_NUMBER_IS_FLOAT": 1,
	// How long an I2C transfer may wait for the bus, in loop turns (codal-nrf52's
	// default of 1000000 is about 14 s in all). A switched-off TPBot Edu holds
	// the bus, so every robot command waits this long before it fails; this
	// makes it about 5 s.
	// ! Must do a clean build after changing it: ./build.py --clean
	"NRF52I2C_TIMEOUT10US": 300000,
	// Whether to compile in the BLE services.
	// ! Must do a clean build after changing it: ./build.py --clean
        "DEVICE_BLE": 0,
	// Controls whether bleManager.init() is called at startup
	"MICROBIT_BLE_ENABLED" : 0,
        "MICROBIT_BLE_PAIRING_MODE": 1,
        "MICROBIT_BLE_DFU_SERVICE": 1,
        "MICROBIT_BLE_DEVICE_INFORMATION_SERVICE": 1,
        "MICROBIT_BLE_EVENT_SERVICE" : 1,
        "MICROBIT_BLE_PARTIAL_FLASHING" : 0,
        "MICROBIT_BLE_OPEN": 1,
        "MICROBIT_TRIPLE_RESET_TO_PAIR": 0
    },
}
