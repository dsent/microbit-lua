--- nrf52833.vanilla.ld	2026-08-04 15:34:52.919371996 +0000
+++ nrf52833.ld	2026-08-04 15:34:59.468372167 +0000
@@ -143,7 +143,9 @@
     } > RAM
     __edata = .;
 
-    __StackSize = 0x800;    /* DEVICE_STACK_SIZE = 2048 */
+    __StackSize = 0x2000;    /* increased: DEVICE_STACK_SIZE = 8192 */
+    /* LUA_CSTACK_REGION_MIN (source/lua-cstack.h): the limits need 4 KB */
+    ASSERT(__StackSize >= 0x1000, "__StackSize is below the 4 KB the C stack limits need (source/lua-cstack.h)")
 
     .bss :
     {
@@ -154,6 +156,41 @@
         . = ALIGN(4);
         __bss_end__ = .;
     } > RAM
+
+    /*
+       The .data section's LMA (load address) is in FLASH at __etext.
+       Its VMA (runtime address) is in RAM. The C runtime copies the
+       initialized data from FLASH to RAM at startup.
+
+       We place the lua metadata block right after the .data LMA,
+       followed by the lua script. This ordering maximizes the space
+       available for the script, since it can grow up to the
+       storage/bootloader boundary.
+
+       The C++ code reads the script directly from FLASH via the
+       linker symbols, so no RAM copy is needed.
+    */
+    __lua_script_max_end = ORIGIN(FLASH) + LENGTH(FLASH);
+
+    . = ALIGN(4);
+
+    .lua_meta (__etext + SIZEOF(.data)) :
+    {
+        __lua_meta = .;
+        LONG(0x4C554131) /* LUA1 */
+        LONG(__lua_script_start)
+        LONG(__lua_script_end)
+        LONG(__lua_script_end - __lua_script_start)
+        LONG(__lua_script_max_end - __lua_script_start)
+    } > FLASH
+
+    .lua_script :
+    {
+        __lua_script_start = .;
+        KEEP(*(.lua_script))
+        __lua_script_end = .;
+    } > FLASH
+
     .heap (NOLOAD):
     {
         __end__ = .;
