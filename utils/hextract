#!/usr/bin/env lua
-- hextract - Intel HEX file inspector for micro:bit firmware
-- Lua 5.1.5 compatible

local USAGE = [[
Usage: lua hextract <command> [args]

Commands:
  structure <file>             Show hex file structure, regions, metadata
  extract <file> [<output>]    Extract the Lua payload from the firmware
  embed <firmware.hex> <script.lua> [<output.hex>] [--overwrite|--in-place]
                               Embed a Lua script into the firmware

If <output> is "-" or omitted for extract, the payload is written to stdout.
If <output.hex> is omitted for embed, you will be prompted to overwrite.
]]

-- Constants from linker script
local LUA_META_LEN  = 0x14  -- 5 x 32-bit words
local LUA_MAGIC     = 0x4C554131

local function u32_le(bytes, offset)
    offset = offset or 1
    return bytes[offset]
         + bytes[offset+1] * 0x100
         + bytes[offset+2] * 0x10000
         + bytes[offset+3] * 0x1000000
end

----------------------------------------------------------------------
-- Metadata detection
----------------------------------------------------------------------

-- Scan all blocks for the LUA1 magic value and validate the metadata.
-- Returns the physical address where the metadata starts, or nil.
local function find_meta_addr(blocks)
    for _, block in ipairs(blocks) do
        -- Scan at 4-byte aligned offsets (metadata is ALIGN(4) in linker)
        local limit = block.length - 19
        for i = 1, limit, 4 do
            local magic = u32_le(block.bytes, i)
            if magic == LUA_MAGIC then
                local script_start = u32_le(block.bytes, i + 4)
                local script_end   = u32_le(block.bytes, i + 8)
                local script_size  = u32_le(block.bytes, i + 12)
                local space        = u32_le(block.bytes, i + 16)
                -- Validate: start < end, size matches, space is reasonable;
                -- a script may fill its space exactly, as embed allows
                if script_start < script_end
                   and script_size == script_end - script_start
                   and script_size > 0
                   and script_size <= space
                   and space < 512 * 1024 then
                    return block.start_addr + i - 1
                end
            end
        end
    end
    return nil
end

----------------------------------------------------------------------
-- Bitwise helpers for Lua 5.1
----------------------------------------------------------------------

-- Bitwise helpers for Lua 5.1.5 compatible
-- Inlined at call sites for performance; kept for rare generic use.
-- Common patterns:
--   bit_and(x, 0xFF)       => x % 0x100
--   bit_rshift(x, 8)       => math.floor(x / 0x100)
--   bit_or(bit_lshift(a,8),b) => a * 0x100 + b
--   bit_lshift(x, n)       => x * (2^n)
--   bit_rshift(x, n)       => math.floor(x / (2^n))

local function bit_and(a, b)
    local r = 0
    local m = 1
    while m <= a and m <= b do
        if (a % (m * 2) >= m) and (b % (m * 2) >= m) then
            r = r + m
        end
        m = m * 2
    end
    return r
end

local function bit_or(a, b)
    local r = 0
    local m = 1
    local limit = math.max(a, b)
    while m <= limit do
        if (a % (m * 2) >= m) or (b % (m * 2) >= m) then
            r = r + m
        end
        m = m * 2
    end
    return r
end

local function bit_lshift(a, n)
    return a * (2 ^ n)
end

local function bit_rshift(a, n)
    return math.floor(a / (2 ^ n))
end

----------------------------------------------------------------------
-- Parsing
----------------------------------------------------------------------

local function parse_hex_line(line)
    line = line:gsub("^%s+", ""):gsub("%s+$", "")
    if line == "" or line:sub(1,1) ~= ":" then
        return nil
    end

    local hex = line:sub(2)
    local len = #hex

    if len < 10 then
        return nil, "line too short"
    end

    if len % 2 ~= 0 then
        return nil, "odd number of hex digits"
    end

    local byte_count = tonumber(hex:sub(1,2), 16)
    local addr       = tonumber(hex:sub(3,6), 16)
    local rec_type   = tonumber(hex:sub(7,8), 16)

    local expected_len = 2 + 4 + 2 + byte_count * 2 + 2
    if len ~= expected_len then
        return nil, string.format("byte count mismatch: header says %d, line has %d data bytes",
                                  byte_count, (len - 10) / 2)
    end

    local data = {}
    for i = 1, byte_count do
        data[i] = tonumber(hex:sub(9 + (i-1)*2, 9 + (i-1)*2 + 1), 16)
    end

    local stored_cksum = tonumber(hex:sub(len-1, len), 16)
    local sum = byte_count + (addr % 0x100) + math.floor(addr / 0x100) + rec_type
    for i = 1, byte_count do
        sum = sum + data[i]
    end
    local calc_cksum = (-sum) % 0x100
    local cksum_ok = (calc_cksum == stored_cksum)

    return {
        byte_count = byte_count,
        addr       = addr,
        rec_type   = rec_type,
        data       = data,
        cksum_ok   = cksum_ok,
    }
end

local function parse_hex_file(filepath)
    local file = io.open(filepath, "r")
    if not file then
        return nil, "cannot open file: " .. filepath
    end

    local blocks = {}
    local cur_block = nil
    local segment_base = 0
    local linear_base  = 0
    local use_linear = false
    local errors = {}
    local total_records = 0
    local cksum_ok = 0
    local start_addr_record = nil

    for raw_line in file:lines() do
        local line = raw_line:gsub("^%s+", ""):gsub("%s+$", "")
        if line ~= "" and line:sub(1,1) == ":" then
            local rec, err = parse_hex_line(line)
            total_records = total_records + 1
            if not rec then
                table.insert(errors, err)
            else
                if rec.cksum_ok then cksum_ok = cksum_ok + 1 end

                if rec.rec_type == 2 then
                    segment_base = (rec.data[1] * 0x100 + rec.data[2]) * 0x10
                    use_linear = false
                elseif rec.rec_type == 3 then
                    start_addr_record = rec.data
                elseif rec.rec_type == 4 then
                    linear_base = (rec.data[1] * 0x100 + rec.data[2]) * 0x10000
                    use_linear = true
                elseif rec.rec_type == 0 then
                    local phys_addr = use_linear and (linear_base + rec.addr) or (segment_base + rec.addr)

                    if cur_block and phys_addr == cur_block.start_addr + cur_block.length and use_linear == cur_block.use_linear then
                        -- Contiguous: extend current block
                        for i = 1, rec.byte_count do
                            cur_block.bytes[cur_block.length + i] = rec.data[i]
                        end
                        table.insert(cur_block.record_lengths, rec.byte_count)
                        cur_block.length = cur_block.length + rec.byte_count
                    else
                        -- Flush and start new block
                        if cur_block then table.insert(blocks, cur_block) end
                        cur_block = {
                            start_addr   = phys_addr,
                            bytes        = {unpack(rec.data)},
                            length       = rec.byte_count,
                            use_linear   = use_linear,
                            record_lengths = {rec.byte_count},
                        }
                    end
                end
            end
        end
    end

    if cur_block then table.insert(blocks, cur_block) end

    file:close()
    return {
        blocks = blocks,
        errors = errors,
        total_records = total_records,
        cksum_ok = cksum_ok,
        start_addr_record = start_addr_record,
    }
end

----------------------------------------------------------------------
-- Block operations
----------------------------------------------------------------------

local function read_bytes(blocks, phys_addr, length)
    local result = {}
    for i = 1, length do result[i] = 0 end

    for _, block in ipairs(blocks) do
        if phys_addr >= block.start_addr and phys_addr < block.start_addr + block.length then
            local off = phys_addr - block.start_addr
            local available = block.length - off
            local to_read = math.min(length, available)
            for i = 1, to_read do
                result[i] = block.bytes[off + i]
            end
            return result
        end
    end
    return result
end

local function write_bytes(blocks, phys_addr, data)
    local len = #data
    for _, block in ipairs(blocks) do
        if phys_addr >= block.start_addr and phys_addr + len <= block.start_addr + block.length then
            local off = phys_addr - block.start_addr
            for i = 1, len do
                block.bytes[off + i] = data[i]
            end
            return true
        end
    end
    return false
end

local function replace_block_range(blocks, addr, old_len, new_data)
    local new_len = #new_data
    for _, block in ipairs(blocks) do
        if addr >= block.start_addr and addr < block.start_addr + block.length then
            local off = addr - block.start_addr
            local available = block.length - off
            local actual_old_len = math.min(old_len, available)
            local new_bytes = {}
            local p = 1
            for i = 1, off do
                new_bytes[p] = block.bytes[i]
                p = p + 1
            end
            for i = 1, new_len do
                new_bytes[p] = new_data[i]
                p = p + 1
            end
            for i = off + actual_old_len + 1, block.length do
                new_bytes[p] = block.bytes[i]
                p = p + 1
            end
            block.bytes = new_bytes
            block.length = block.length - actual_old_len + new_len
            return true
        end
    end
    return false
end

----------------------------------------------------------------------
-- Serialization
----------------------------------------------------------------------

local function calc_checksum(addr, rec_type, data)
    local sum = #data + (addr % 0x100) + math.floor(addr / 0x100) + rec_type
    for i = 1, #data do
        sum = sum + data[i]
    end
    return (-sum) % 0x100
end

local function make_hex_line(addr, rec_type, data)
    local len = #data
    local cksum = calc_checksum(addr, rec_type, data)
    local line = string.format(":%02X%04X%02X", len, addr, rec_type)
    for i = 1, len do
        line = line .. string.format("%02X", data[i])
    end
    line = line .. string.format("%02X", cksum)
    return line
end

local function serialize_blocks(blocks, out, start_addr_record)
    local current_base = nil
    local current_type = nil

    for _, block in ipairs(blocks) do
        local offset = 0
        local rec_idx = 0

        while offset < block.length do
            local phys = block.start_addr + offset

            if block.use_linear then
                local upper = bit_rshift(phys, 16)
                local lin_base = bit_lshift(upper, 16)
                if lin_base ~= current_base or current_type ~= "linear" then
                    if current_type == "segment" and current_base ~= 0 then
                        out:write(make_hex_line(0, 2, {0, 0}) .. "\n")
                    end
                    out:write(make_hex_line(0, 4, {math.floor(upper / 0x100), upper % 0x100}) .. "\n")
                    current_base = lin_base
                    current_type = "linear"
                end
                local addr = phys - current_base
                local chunk
                if block.record_lengths and rec_idx < #block.record_lengths then
                    rec_idx = rec_idx + 1
                    chunk = block.record_lengths[rec_idx]
                else
                    chunk = math.min(16, block.length - offset)
                end
                local data = {}
                for i = 1, chunk do
                    data[i] = block.bytes[offset + i]
                end
                out:write(make_hex_line(addr, 0, data) .. "\n")
                offset = offset + chunk
            else
                local seg = math.floor(phys / 0x10000) % 16 * 0x1000
                local seg_base = seg * 0x10
                local addr_in_seg = phys - seg_base
                if seg_base ~= current_base or current_type ~= "segment" then
                    if seg ~= 0 or current_base ~= nil then
                        out:write(make_hex_line(0, 2, {math.floor(seg / 0x100), seg % 0x100}) .. "\n")
                    end
                    current_base = seg_base
                    current_type = "segment"
                end
                local chunk
                if block.record_lengths and rec_idx < #block.record_lengths then
                    rec_idx = rec_idx + 1
                    chunk = block.record_lengths[rec_idx]
                else
                    chunk = math.min(16, block.length - offset)
                end
                local data = {}
                for i = 1, chunk do
                    data[i] = block.bytes[offset + i]
                end
                out:write(make_hex_line(addr_in_seg, 0, data) .. "\n")
                offset = offset + chunk
            end
        end
    end

    if start_addr_record then
        out:write(make_hex_line(0, 3, start_addr_record) .. "\n")
    end
    out:write(":00000001FF\n")
end

----------------------------------------------------------------------
-- Output helpers
----------------------------------------------------------------------

local function fmt_size(n)
    if n >= 1024*1024 then
        return string.format("%.1f MB", n / (1024*1024))
    elseif n >= 1024 then
        return string.format("%.1f KB", n / 1024)
    else
        return string.format("%d B", n)
    end
end

local function u32_to_le_bytes(val)
    return {
        val % 0x100,
        math.floor(val / 0x100) % 0x100,
        math.floor(val / 0x10000) % 0x100,
        math.floor(val / 0x1000000),
    }
end

local function pack_meta(magic, start, end_addr, size, available_space)
    local b = {}
    local p = 1
    for _, v in ipairs(u32_to_le_bytes(magic)) do b[p] = v; p = p + 1 end
    for _, v in ipairs(u32_to_le_bytes(start)) do b[p] = v; p = p + 1 end
    for _, v in ipairs(u32_to_le_bytes(end_addr)) do b[p] = v; p = p + 1 end
    for _, v in ipairs(u32_to_le_bytes(size)) do b[p] = v; p = p + 1 end
    for _, v in ipairs(u32_to_le_bytes(available_space)) do b[p] = v; p = p + 1 end
    return b
end

----------------------------------------------------------------------
-- Commands
----------------------------------------------------------------------

local function cmd_structure(args)
    local filepath = args[1]
    if not filepath then
        io.stderr:write("Error: no input file specified\n")
        io.stderr:write(USAGE)
        return 1
    end

    local parsed, err = parse_hex_file(filepath)
    if not parsed then
        io.stderr:write("Error: " .. err .. "\n")
        return 1
    end

    local blocks = parsed.blocks
    local errors = parsed.errors

    local total_data_bytes = 0
    for _, block in ipairs(blocks) do
        total_data_bytes = total_data_bytes + block.length
    end

    print("=== DATA REGIONS ===")
    if #blocks == 0 then
        print("  No data records found")
    else
        for i, block in ipairs(blocks) do
            local end_addr = block.start_addr + block.length - 1
            print(string.format("  Region %d: 0x%08X - 0x%08X  (%s)",
                  i, block.start_addr, end_addr, fmt_size(block.length)))
        end
    end
    print()

    print("=== LUA METADATA ===")
    local meta_addr = find_meta_addr(blocks)
    if not meta_addr then
        print("  No metadata found (LUA1 magic not detected)")
        print("  The firmware may not have a Lua payload embedded")
    else
        print(string.format("  Found at 0x%08X", meta_addr))
        local meta_bytes = read_bytes(blocks, meta_addr, LUA_META_LEN)
        local magic = u32_le(meta_bytes, 1)
        local script_start = u32_le(meta_bytes, 5)
        local script_end   = u32_le(meta_bytes, 9)
        local script_size  = u32_le(meta_bytes, 13)
        local avail_space  = u32_le(meta_bytes, 17)

        local magic_str
        if magic == LUA_MAGIC then
            magic_str = string.format("0x%08X (\"LUA1\")", magic)
        else
            magic_str = string.format("0x%08X (expected 0x%08X \"LUA1\")", magic, LUA_MAGIC)
        end
        print("  Magic: " .. magic_str)
        print(string.format("  Start: 0x%08X (%d)", script_start, script_start))
        print(string.format("  End:   0x%08X (%d)", script_end, script_end))
        print(string.format("  Size:  0x%08X (%d)", script_size, script_size))
        print(string.format("  Space: 0x%08X (%d)", avail_space, avail_space))

        local calc_size = script_end - script_start
        print()
        print("  Sanity checks:")
        if magic == LUA_MAGIC then
            print("    Magic: OK")
        else
            print("    Magic: FAIL")
        end
        if script_start < script_end then
            print(string.format("    Start < End: OK (difference = %d bytes)", calc_size))
        else
            print("    Start < End: FAIL")
        end
        if script_size == calc_size then
            print(string.format("    Size == End - Start: OK (%d bytes)", script_size))
        else
            print(string.format("    WARNING: Size (%d) != End - Start (%d)", script_size, calc_size))
        end

        if magic == LUA_MAGIC and script_start < script_end and calc_size > 0 and calc_size < 512 * 1024 then
            local preview_len = math.min(calc_size, 256)
            local script_bytes = read_bytes(blocks, script_start, preview_len)
            local script_str = ""
            for i = 1, preview_len do
                local b = script_bytes[i]
                if b >= 32 and b < 127 then
                    script_str = script_str .. string.char(b)
                elseif b == 10 or b == 13 then
                    script_str = script_str .. string.char(b)
                else
                    script_str = script_str .. "?"
                end
            end
            print()
            print("  Script preview (first " .. preview_len .. " bytes):")
            for l in script_str:gmatch("[^\n]*\n?") do
                if l ~= "" then
                    print("    " .. l)
                end
            end
        end
    end
    print()

    if #errors > 0 then
        print("=== CHECKSUM / FORMAT ERRORS ===")
        for _, e in ipairs(errors) do
            print("  " .. e)
        end
        print()
    end

    print("=== SUMMARY ===")
    print(string.format("  Total records: %d", parsed.total_records))
    print(string.format("  Total data bytes: %d (%s)", total_data_bytes, fmt_size(total_data_bytes)))

    if #blocks > 0 then
        local min_addr = blocks[1].start_addr
        local max_addr = blocks[1].start_addr + blocks[1].length - 1
        local gap_count = 0
        local gap_size = 0
        for i = 1, #blocks do
            local b = blocks[i]
            local b_end = b.start_addr + b.length - 1
            if b.start_addr < min_addr then min_addr = b.start_addr end
            if b_end > max_addr then max_addr = b_end end
            if i > 1 then
                local prev_end = blocks[i-1].start_addr + blocks[i-1].length - 1
                local gap = b.start_addr - prev_end - 1
                if gap > 0 then
                    gap_count = gap_count + 1
                    gap_size = gap_size + gap
                end
            end
        end
        print(string.format("  Address range: 0x%08X - 0x%08X", min_addr, max_addr))
        print(string.format("  Gaps: %d (total %s)", gap_count, fmt_size(gap_size)))
    end

    print(string.format("  Checksums: %d/%d valid", parsed.cksum_ok, parsed.total_records))
    if #errors > 0 then
        print(string.format("  Errors: %d", #errors))
    end

    return 0
end

local function cmd_extract(args)
    local filepath = args[1]
    if not filepath then
        io.stderr:write("Error: no input file specified\n")
        io.stderr:write(USAGE)
        return 1
    end

    local output = args[2]
    if output == "-" then
        output = nil
    end

    local parsed, err = parse_hex_file(filepath)
    if not parsed then
        io.stderr:write("Error: " .. err .. "\n")
        return 1
    end

    local blocks = parsed.blocks

    local meta_addr = find_meta_addr(blocks)
    if not meta_addr then
        io.stderr:write("Error: no Lua metadata found (LUA1 magic not detected)\n")
        return 1
    end

    local meta_bytes = read_bytes(blocks, meta_addr, LUA_META_LEN)

    local magic = u32_le(meta_bytes, 1)
    local script_start = u32_le(meta_bytes, 5)
    local script_end   = u32_le(meta_bytes, 9)
    local script_size  = u32_le(meta_bytes, 13)

    if magic ~= LUA_MAGIC then
        io.stderr:write(string.format("Error: bad magic 0x%08X (expected 0x%08X)\n", magic, LUA_MAGIC))
        return 1
    end

    if script_start >= script_end then
        io.stderr:write(string.format("Error: script start (0x%08X) >= end (0x%08X)\n", script_start, script_end))
        return 1
    end

    local size = script_end - script_start
    if script_size ~= size then
        io.stderr:write(string.format("Warning: metadata size (%d) != end - start (%d), using end - start\n", script_size, size))
    end

    local script_bytes = read_bytes(blocks, script_start, size)

    local out
    if output then
        out = io.open(output, "wb")
        if not out then
            io.stderr:write("Error: cannot open output file: " .. output .. "\n")
            return 1
        end
    else
        out = io.stdout
    end

    for i = 1, size do
        out:write(string.char(script_bytes[i]))
    end

    if output then
        out:close()
    end

    return 0
end

local function cmd_embed(args)
    local filepath = args[1]
    local script_path = args[2]
    local overwrite = false

    local positional = {}
    for i = 3, #args do
        if args[i] == "--overwrite" or args[i] == "--in-place" then
            overwrite = true
        else
            table.insert(positional, args[i])
        end
    end
    local output_path = positional[1] or nil

    if not filepath or not script_path then
        io.stderr:write("Error: missing arguments\n")
        io.stderr:write(USAGE)
        return 1
    end

    local parsed, err = parse_hex_file(filepath)
    if not parsed then
        io.stderr:write("Error: " .. err .. "\n")
        return 1
    end

    local blocks = parsed.blocks

    local meta_addr = find_meta_addr(blocks)
    if not meta_addr then
        io.stderr:write("Error: no Lua metadata found (LUA1 magic not detected)\n")
        return 1
    end

    local meta_bytes = read_bytes(blocks, meta_addr, LUA_META_LEN)

    local magic = u32_le(meta_bytes, 1)
    local old_start = u32_le(meta_bytes, 5)
    local old_end = u32_le(meta_bytes, 9)
    local avail_space = u32_le(meta_bytes, 17)

    local script_file = io.open(script_path, "rb")
    if not script_file then
        io.stderr:write("Error: cannot open script file: " .. script_path .. "\n")
        return 1
    end
    local script_data = script_file:read("*all")
    script_file:close()
    local script_len = #script_data

    if script_len > avail_space then
        io.stderr:write(string.format(
            "Error: script too large: %d bytes, max %d bytes\n",
            script_len, avail_space))
        return 1
    end

    if old_start >= old_end then
        io.stderr:write("Error: invalid script range in metadata\n")
        return 1
    end

    local new_end = old_start + script_len
    local old_len = old_end - old_start

    local script_bytes = {}
    for i = 1, script_len do
        script_bytes[i] = string.byte(script_data, i)
    end

    replace_block_range(blocks, old_start, old_len, script_bytes)

    local meta_data = pack_meta(LUA_MAGIC, old_start, new_end, script_len, avail_space)
    write_bytes(blocks, meta_addr, meta_data)

    if not output_path then
        if overwrite then
            output_path = filepath
        else
            io.write(string.format("Overwrite %s? [y/N]\n", filepath))
            io.write("(or provide a fourth argument to write to a different file, or use --overwrite)\n")
            io.write("> ")
            io.flush()
            local answer = io.read("*line")
            if answer ~= "y" and answer ~= "Y" and answer ~= "yes" and answer ~= "YES" then
                io.stderr:write("Aborted.\n")
                return 1
            end
            output_path = filepath
        end
    end

    local out = io.open(output_path, "wb")
    if not out then
        io.stderr:write("Error: cannot open output file: " .. output_path .. "\n")
        return 1
    end

    serialize_blocks(blocks, out, parsed.start_addr_record)
    out:close()

    print(string.format("Embedded %d bytes at 0x%08X", script_len, old_start))
    return 0
end

----------------------------------------------------------------------
-- Dispatch
----------------------------------------------------------------------

local command = arg[1]
if not command then
    io.stderr:write(USAGE)
    os.exit(1)
end

local cmd_args = {}
for i = 2, #arg do
    table.insert(cmd_args, arg[i])
end

if command == "structure" then
    os.exit(cmd_structure(cmd_args))
elseif command == "extract" then
    os.exit(cmd_extract(cmd_args))
elseif command == "embed" then
    os.exit(cmd_embed(cmd_args))
else
    io.stderr:write("Unknown command: " .. command .. "\n")
    io.stderr:write(USAGE)
    os.exit(1)
end
